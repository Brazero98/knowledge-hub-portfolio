# Knowledge Hub — environment variables. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real credentials.

# --- Required ---
SUPABASE_URL=https://YOUR_SUPABASE_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
APP_PASSWORD=choose-a-password-for-the-web-library
MCP_TOKEN=choose-a-bearer-token-for-the-mcp-endpoint

# --- Optional: Telegram capture (send links to a bot) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
TELEGRAM_MODE=polling

# --- Optional: weekly email digest ---
RESEND_API_KEY=your-resend-api-key
DIGEST_EMAIL_TO=you@example.com

# --- Optional: link base used in digest emails ---
WEB_APP_URL=http://localhost:8000
